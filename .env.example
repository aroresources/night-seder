# From your Supabase project: Settings -> API (or Project Settings -> API keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service-role (secret) key. It bypasses row level security, so it is read
# by exactly one file — the texting webhook, which has no signed-in user to
# carry and otherwise reads every man as a stranger. Never prefix it
# NEXT_PUBLIC_, never paste it anywhere else, and rotate it if it leaks.
SUPABASE_SERVICE_ROLE_KEY=

# Texting, from Twilio. These are server-side secrets: they must NOT be
# prefixed NEXT_PUBLIC_, or they would be compiled into the browser bundle.
# The Messaging Service is what carries the 10DLC registration; it wins over
# a bare from-number when both are set.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
